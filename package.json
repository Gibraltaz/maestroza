{
  "private": true,
  "workspaces": [
    "translation",
    "kernel",
    "core",
    "platform",
    "client",
    "shell",
    "backend",
    "frontend",
    "ext/couchdb-store"
  ],
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run rest --workspaces --if-present",
    "docker:build": "docker compose -f docker/docker-compose-build.yml build",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
    "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "tsx": "4.23.15"
  }
}
